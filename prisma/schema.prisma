generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//======================================================
// USER MANAGEMENT
//======================================================

model User {
  id           String    @id @default(uuid())
  username     String    @unique
  email        String    @unique
  passwordHash String?
  role         String    @default("user")
  lastLogin    DateTime?
  isActive     Boolean   @default(true)

  // Relations
  blogs    Blog[]
  projects Project[]

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([role])
}

//======================================================
// BLOG MANAGEMENT
//======================================================

model Blog {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  content     String    @db.Text
  summary     String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  viewCount   Int       @default(0)

  // Relations
  authorId String
  author   User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  images   BlogImage[]

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([published])
  @@index([slug])
}

model BlogImage {
  id        String  @id @default(uuid())
  url       String
  filename  String
  alt       String?
  caption   String?
  sortOrder Int     @default(0)

  // Relations
  blogId String?
  blog   Blog?   @relation(fields: [blogId], references: [id], onDelete: Cascade)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([blogId])
}

//======================================================
// GALLERY MANAGEMENT
//======================================================

model Gallery {
  id          String  @id @default(uuid())
  name        String
  description String?
  slug        String  @unique
  isActive    Boolean @default(true)

  // Relations
  images GalleryImage[]

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([isActive])
}

model GalleryImage {
  id        String  @id @default(uuid())
  url       String
  filename  String
  alt       String?
  caption   String?
  sortOrder Int     @default(0)

  // Relations
  galleryId String
  gallery   Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([galleryId])
}

//======================================================
// WALKTHROUGH MANAGEMENT
//======================================================

model Walkthrough {
  id          String  @id @default(uuid())
  title       String
  description String?
  videoUrl    String
  thumbnail   String
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

//======================================================
// PRESS & COVERAGE MANAGEMENT
//======================================================

model Press {
  id          String  @id @default(uuid())
  name        String
  description String?
  slug        String  @unique
  isActive    Boolean @default(true)

  // Relations
  items PressItem[]

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([isActive])
}

model PressItem {
  id              String    @id @default(uuid())
  title           String
  publicationName String?
  publicationDate DateTime?
  url             String?
  imageUrl        String?
  excerpt         String?
  sortOrder       Int       @default(0)

  // Relations
  pressId String
  press   Press  @relation(fields: [pressId], references: [id], onDelete: Cascade)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pressId])
}

//======================================================
// PROJECT MANAGEMENT
//======================================================

enum ProjectStatus {
  UNDER_CONSTRUCTION
  COMPLETED
}

enum ProjectCategory {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
  HEALTHCARE
  RENOVATION
  SPORTS
}

model ProjectGroup {
  id            String  @id @default(uuid())
  name          String
  slug          String  @unique
  description   String? @db.Text
  coverImageUrl String?
  isActive      Boolean @default(true)
  sortOrder     Int     @default(0)

  // Relations
  projects Project[]

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([isActive])
}

model Project {
  id             String          @id @default(uuid())
  title          String
  slug           String          @unique
  description    String
  content        String          @db.Text
  logoUrl        String
  status         ProjectStatus   @default(UNDER_CONSTRUCTION)
  category       ProjectCategory @default(RESIDENTIAL)
  completionDate DateTime?
  featured       Boolean         @default(false)
  published      Boolean         @default(false)
  publishedAt    DateTime?
  viewCount      Int             @default(0)

  // Project Group
  groupId String?
  group   ProjectGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  // Overview section
  overviewHeadline    String?
  overviewDescription String? @db.Text
  location            String?

  // Specifications & Features
  specifications ProjectSpecification[]

  // Amenities
  amenities ProjectAmenity[]

  // Plans
  sitePlanHeadline    String?
  sitePlanImage       String?
  sitePlanBrochureUrl String?

  currentPlanHeadline    String?
  currentPlanImage       String?
  currentPlanBrochureUrl String?

  unitPlanHeadline    String?
  unitPlanImage       String?
  unitPlanBrochureUrl String?

  // Location details
  mapUrl            String?
  nearbyAttractions String? @db.Text
  locationDetails   String? @db.Text

  // Relations
  authorId String
  author   User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  images   ProjectImage[]

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([slug])
  @@index([published])
  @@index([featured])
  @@index([groupId])
  @@index([category])
}

model ProjectImage {
  id           String  @id @default(uuid())
  url          String
  filename     String
  alt          String?
  caption      String?
  isFeatured   Boolean @default(false)
  displayOrder Int     @default(0)

  // Relations
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([isFeatured])
}

model ProjectSpecification {
  id           String @id @default(uuid())
  title        String
  description  String @db.Text
  imageUrl     String
  displayOrder Int    @default(0)

  // Relations
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model ProjectAmenity {
  id           String @id @default(uuid())
  name         String
  imageUrl     String
  displayOrder Int    @default(0)

  // Relations
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

//======================================================
// LEAD / ENQUIRY MANAGEMENT
//======================================================

enum LeadType {
  CONTACT
  LEAD
  SITE_VISIT
}

enum LeadStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  CONVERTED
  CLOSED
}

model Lead {
  id String @id @default(uuid())

  // Submission type
  type LeadType @default(LEAD)

  // Lead management status
  status LeadStatus @default(NEW)

  // Common contact details
  name  String
  phone String
  email String?

  // Project / enquiry details
  project      String?
  propertyType String?
  budget       String?

  // Site visit details
  visitDate DateTime?
  visitTime String?

  // Additional message / notes
  message String?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([email])
  @@index([phone])
  @@index([createdAt])
}

//======================================================
// WEBSITE / SITE SETTINGS
//======================================================
//
// Single global record for the public CCS website.
// This will allow the admin panel to edit:
//
// - Company/contact information
// - Phone number
// - Email
// - Website addresses
// - Social media links
// - Registered office
// - Corporate office
// - Other footer/contact information
//

model SiteSettings {
  id Int @id @default(1)

  // Company information
  companyName        String?
  companyDescription String?

  // Contact information
  phone    String?
  phone2   String?
  email    String?
  email2   String?
  whatsapp String?

  // Website
  websiteUrl String?

  // Main address
  address String? @db.Text

  // Office addresses
  registeredOffice String? @db.Text
  corporateOffice  String? @db.Text

  // Social media
  facebookUrl  String?
  instagramUrl String?
  youtubeUrl   String?
  linkedinUrl  String?
  twitterUrl   String?

  // Branding
  logoUrl    String?
  faviconUrl String?
  footerText String? @db.Text

  // Optional additional information
  mapUrl       String?
  googleMapUrl String?
  workingHours String?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//======================================================
// LEADERSHIP / PARTNERS / TEAM
//======================================================
//
// Admin-editable leadership/team section.
// Used for entries like:
//
// Faisal Aslam
// Zeeshan Aslam
// Suhail Aslam
// Shoaib Akram
//
// Admin will eventually be able to:
// - Add member
// - Edit member
// - Change name
// - Change designation
// - Change experience
// - Change image
// - Change bio
// - Enable/disable member
// - Reorder members
//

model Leadership {
  id String @id @default(uuid())

  // Basic information
  name        String
  designation String

  // Profile information
  imageUrl   String?
  experience String?
  bio        String? @db.Text

  // Display controls
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}
